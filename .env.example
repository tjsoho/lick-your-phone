NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (filled in — dev project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Service Role Key (server-side)
# Get from: Supabase Dashboard → Project Settings → API → service_role → Reveal
SUPABASE_SERVICE_ROLE_KEY=

# Pinch Payments — https://docs.getpinch.com.au
# Leave empty to disable (form still renders for testing)
PINCH_MERCHANT_ID=
PINCH_SECRET_KEY=
NEXT_PUBLIC_PINCH_PUBLISHABLE_KEY=
PINCH_API_URL=
PINCH_WEBHOOK_SECRET=

# n8n Webhook — fires on proposal_signed and intake_completed
# Downstream: Slack, ClickUp, internal emails
# Leave empty to skip webhook emission
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Hotjar — leave empty to disable
NEXT_PUBLIC_HOTJAR_ID=